{
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=namdev-connect-frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://namdev-connect-backend-production.up.railway.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
